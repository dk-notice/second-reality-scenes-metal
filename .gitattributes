# Git LFS (Large File Storage): these files are kept on the LFS server, and the repository itself
# holds only a small pointer to each. Needs `git lfs` installed (brew install git-lfs; git lfs install).
# Only the high-resolution artwork: the small exported originals in artwork/original/ stay ordinary files.
artwork/modern/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[tT][iI][fF] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[tT][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[wW][eE][bB][pP] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[kK][rR][aA] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[xX][cC][fF] filter=lfs diff=lfs merge=lfs -text
artwork/modern/**/*.[eE][xX][rR] filter=lfs diff=lfs merge=lfs -text
